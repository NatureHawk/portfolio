# Nothing here is needed to serve the site — vendor/ holds the only runtime
# dependency, so node_modules exists purely to regenerate it.
node_modules

# Source material and docs. Keeping them out of the deployment keeps the
# upload small; they stay in the repo.
assets/sleeping-fat-cat-figurine-*
assets/fairy_lights.blend
assets/lofi-room.png
scripts

# THE IMAGE MASTERS. Every photograph the site actually loads is a .webp
# generated from these by `npm run images`; the .png and .jpeg originals are
# the lossless/original sources and stay in the repo so the webp can always be
# regenerated. Deploying both would upload 19 MB to serve 3 MB.
# If you add a photograph, run `npm run images` before deploying — a source
# with no encoded counterpart is simply a missing image in production.
assets/*.png
assets/website3/*.jpeg
assets/website3/*.jpg
.vscode
HANDOFF.md
README.md
vendor/README.md
assets/projects/README.md
